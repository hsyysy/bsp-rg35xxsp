# RG35XX-SP configuration fragment, merged with arm64 defconfig.
# PMIC, audio, SDIO WiFi, GPU dependencies, LCD, storage and Cedrus VPU.
# Bluetooth remains disabled because combo-chip setup can disrupt WiFi.
# PCF8563 is built in for early boot timekeeping; DTS pins it to rtc0.
# Keep kernelrelease stable for module installation (also set LOCALVERSION="").

CONFIG_AXP20X_POWER=m
CONFIG_AXP20X_ADC=m
CONFIG_BATTERY_AXP20X=m
CONFIG_INPUT_AXP20X_PEK=m
CONFIG_SND_SUN4I_CODEC=m
CONFIG_RTW88=m
CONFIG_RTW88_CORE=m
CONFIG_RTW88_SDIO=m
CONFIG_RTW88_8821C=m
CONFIG_RTW88_8821CS=m
CONFIG_BT=n
CONFIG_ARM_ALLWINNER_SUN50I_CPUFREQ_NVMEM=y
CONFIG_SUN50I_IOMMU=y
CONFIG_SUN50I_H6_PRCM_PPU=y
CONFIG_DRM_PANEL_NEWVISION_NV3052C=m
CONFIG_SPI_GPIO=m
CONFIG_BACKLIGHT_GPIO=m
CONFIG_EXFAT_FS=y
CONFIG_BINFMT_MISC=y
CONFIG_SECURITY_NETWORK=y
CONFIG_NF_TABLES=m
CONFIG_RTC_DRV_PCF8563=y
CONFIG_CMA_SIZE_MBYTES=64
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_VIDEO_SUNXI=y
CONFIG_VIDEO_SUNXI_CEDRUS=m
# CONFIG_LOCALVERSION_AUTO is not set
